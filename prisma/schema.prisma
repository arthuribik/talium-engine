// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  UNVERIFIED
  VERIFIED
  ACTIVE
  SUSPENDED
  PENDING_INVITATION
}

enum UserType {
  ADMIN
  ORGANISATION
  PROFESSIONAL
}

enum AdminRole {
  super_admin
  admin
  support
  auditor
}

enum OrgRole {
  org_owner
  org_admin
  org_recruiter
  org_member
}

enum OrganisationActivityLogLevel {
  success
  info
  warning
  error
}

enum VerificationStatus {
  pending
  under_review
  verified
  rejected
  not_activated
}

enum JobStatus {
  draft
  published
  paused
  closed
}

enum EmploymentType {
  full_time
  part_time
  contract
  internship
}

enum WorkMode {
  remote
  hybrid
  on_site
  global_remote
}

enum IDType {
  national_id
  passport
  drivers_license
  voters_card
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  password          String
  firstName         String
  lastName          String
  phoneNumber       String?
  phoneVerified     Boolean    @default(false)
  status            UserStatus @default(UNVERIFIED)
  userType          UserType
  emailVerified     Boolean    @default(false)
  emailVerifyToken  String?
  emailVerifyExpiry DateTime?
  resetToken        String?
  resetTokenExpiry  DateTime?
  firstLogin        Boolean    @default(true)
  twoFactorEnabled  Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  adminProfile Admin?
  organisation Organisation?
  professional Professional?
  organisationMembers OrganisationMember[]

  @@map("users")
}

model Admin {
  id                  String    @id @default(cuid())
  userId              String    @unique
  role                AdminRole @default(admin)
  invitationToken     String?   @unique
  invitationExpiresAt DateTime?
  invitationSentAt    DateTime?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model AdminCustomRole {
  id            String   @id @default(cuid())
  name          String
  description   String   @db.Text
  permissions   Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("admin_custom_roles")
}

model Organisation {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  companyName            String
  country                String
  isRegistered           Boolean            @default(false)
  incorporationStatus    String?
  countryOfIncorporation String?
  incorporationNumber    String?
  yearOfCommencement     Int?
  industry               String?
  companySize            String?
  website                String?
  logoUrl                String?
  description            String?
  verificationStatus     VerificationStatus @default(not_activated)
  setupCompleted         Boolean            @default(false)
  profileCompleteness    Int                @default(0)
  address                Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationRequests OrganisationVerification[]
  jobs                 Job[]
  members              OrganisationMember[]
  invitations          OrganisationInvitation[]
  keyEmployees         OrganisationKeyEmployee[]
  billingTransactions  OrganisationBillingTransaction[]
  organisationInvoices OrganisationInvoice[]
  customRoles          OrganisationCustomRole[]
  activityLogs         OrganisationActivityLog[]
  integrations         OrganisationIntegration[]
  talentScouts         OrganisationTalentScout[]

  @@map("organisations")
}

model OrganisationTalentScout {
  id               String   @id @default(cuid())
  organisationId   String
  name             String
  criteria         Json
  matchCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organisation Organisation                     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  matches      OrganisationTalentScoutMatch[]

  @@index([organisationId])
  @@map("organisation_talent_scouts")
}

model OrganisationTalentScoutMatch {
  id               String   @id @default(cuid())
  scoutId          String
  professionalId   String
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  scout        OrganisationTalentScout @relation(fields: [scoutId], references: [id], onDelete: Cascade)
  professional Professional            @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([scoutId, professionalId])
  @@index([scoutId])
  @@map("organisation_talent_scout_matches")
}

model OrganisationIntegration {
  id             String   @id @default(cuid())
  organisationId String
  provider       String
  connected      Boolean  @default(false)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, provider])
  @@index([organisationId])
  @@map("organisation_integrations")
}

model OrganisationActivityLog {
  id               String                       @id @default(cuid())
  organisationId String
  action           String
  actorName        String
  actorUserId      String?
  details          String                       @db.Text
  level            OrganisationActivityLogLevel
  createdAt        DateTime                     @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, createdAt])
  @@map("organisation_activity_logs")
}

model OrganisationCustomRole {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  description    String   @db.Text
  permissions    Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("organisation_custom_roles")
}

enum BillingEntityType {
  professional
  organisation
}

model BillingSubscriptionPlan {
  id              String            @id @default(cuid())
  planSlug        String
  entityType      BillingEntityType
  name            String
  description     String            @db.Text
  priceMonthlyUsd Decimal           @default(0) @db.Decimal(12, 2)
  priceAnnualUsd  Decimal?          @db.Decimal(12, 2)
  priceMonthlyNgn Int?
  priceAnnualNgn  Int?
  features        Json?
  displayOrder    Int               @default(0)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([entityType, planSlug])
  @@index([entityType, isActive])
  @@map("billing_subscription_plans")
}

model OrganisationBillingTransaction {
  id               String   @id @default(cuid())
  organisationId String
  occurredAt       DateTime @default(now())
  status           String
  type             String
  amountNgn        Int      @default(0)
  ttkDelta         Int?
  ttkColor         String?
  description      String   @db.Text
  reference        String?
  metadata         Json?
  createdAt        DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, occurredAt])
  @@map("organisation_billing_transactions")
}

model OrganisationInvoice {
  id               String   @id @default(cuid())
  organisationId String
  invoiceNumber    String
  issuedAt         DateTime @default(now())
  amountNgn        Int      @default(0)
  status           String
  description      String   @db.Text
  downloadUrl      String?
  createdAt        DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, invoiceNumber])
  @@index([organisationId, issuedAt])
  @@map("organisation_invoices")
}

model OrganisationKeyEmployee {
  id             String   @id @default(cuid())
  organisationId String
  firstName      String
  lastName       String
  title          String
  bio            String?  @db.Text
  email          String?
  linkedInUrl    String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@map("organisation_key_employees")
}

model OrganisationMember {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  role           OrgRole  @default(org_member)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@map("organisation_members")
}

model OrganisationInvitation {
  id             String   @id @default(cuid())
  organisationId String
  email          String
  role           OrgRole
  token          String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, email])
  @@map("organisation_invitations")
}

model OrganisationVerification {
  id                      String             @id @default(cuid())
  organisationId          String
  status                  VerificationStatus @default(under_review)
  documents               Json
  submittedAt             DateTime           @default(now())
  estimatedCompletionDate DateTime?
  reviewedAt              DateTime?
  reviewedBy              String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@map("organisation_verifications")
}

model Professional {
  id                  String             @id @default(cuid())
  userId              String             @unique
  profession          String?
  gender              String?
  middleName          String?
  country             String?
  nationality         String?
  dateOfBirth         DateTime?
  description         String?
  socialMedia         Json?
  certifications      Json?
  familyInfo          Json?
  idType              IDType?
  idNumber            String?
  idDocumentUrl       String?
  locationDocumentType String?
  locationDocumentUrl  String?
  profileImageUrl      String?
  /// Liveness verification selfie (S3); separate from public profile photo
  livenessSelfieUrl    String?
  /// Set when the professional has finished the personal verification liveness step (persists across reloads).
  isPersonalCompleted  Boolean            @default(false)
  /// IANA timezone, e.g. Africa/Lagos
  timezone             String?
  locations            Json?
  identityVerified    Boolean            @default(false)
  identityStatus      VerificationStatus @default(not_activated)
  verifiedByAdminAt   DateTime?
  setupCompleted      Boolean            @default(false)
  profileCompleteness Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityVerification IdentityVerification?
  education            Education[]
  workExperience       WorkExperience[]
  professionalProjects ProfessionalProject[]
  jobApplications      JobApplication[]
  savedJobs            SavedJob[]
  jobSettings          ProfessionalJobSettings?
  profileEditRequests  ProfessionalProfileEditRequest[]
  talentScoutMatches   OrganisationTalentScoutMatch[]

  @@map("professionals")
}

model ProfessionalProfileEditRequest {
  id                    String             @id @default(cuid())
  professionalId      String
  fields                Json
  reason                String
  supportingDocumentUrl String?
  status                VerificationStatus @default(under_review)
  submittedAt           DateTime           @default(now())
  reviewedAt            DateTime?
  reviewedBy            String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@map("professional_profile_edit_requests")
}

model IdentityVerification {
  id                String             @id @default(cuid())
  professionalId    String             @unique
  nationality       String
  idType            IDType
  idNumber          String
  dateOfBirth       DateTime
  status            VerificationStatus @default(pending)
  livenessCheckData Json?
  verifiedAt        DateTime?
  reviewedBy        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("identity_verifications")
}

model Education {
  id                    String             @id @default(cuid())
  professionalId        String
  levelOfEducation      String
  programLevel          String?
  schoolType            String?
  institutionName       String
  institutionIndustry   String?
  degreeType            String?
  fieldOfStudy          String
  startDate             String
  endDate               String?
  currentlyAttending    Boolean            @default(false)
  grade                 String?
  costOfEducation       Float?
  currency              String?
  costFrequency         String?
  pendingLoanAmount     Float?
  loanCurrency          String?
  loanRepaymentFrequency String?
  scholarshipsAndAid    String?            @db.Text
  programDescription    String?            @db.Text
  academicResponsibilities String?         @db.Text
  academicAchievements  String?          @db.Text
  programProgression    Json?
  activitiesSocieties   String?            @db.Text
  associatedSkills      String?
  supportingMediaUrl    String?
  country               String
  isDefault             Boolean            @default(false)
  verificationMethod    String?
  /// Institution email used for student-email OTP verification (when applicable).
  studentVerificationEmail String?
  verificationStatus    VerificationStatus @default(pending)
  verificationDocuments Json?
  verifiedAt            DateTime?
  reviewedBy            String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("educations")
}

model WorkExperience {
  id                  String             @id @default(cuid())
  professionalId      String
  organisationName    String
  industry            String
  location            Json
  role                String
  employmentType      EmploymentType
  workMode            WorkMode
  startDate           String
  endDate             String?
  currentlyWorking    Boolean            @default(false)
  jobDescription      String?            @db.Text
  responsibilities    String[]
  achievements        String[]
  paymentMode         String?
  currency            String?
  salaryRange         Json?
  verificationMethod  String?
  /// Company email used for work-email OTP verification (when applicable).
  workVerificationEmail String?
  supportingMediaUrl  String?
  verificationStatus  VerificationStatus @default(pending)
  verifiedAt          DateTime?
  reviewedBy          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("work_experiences")
}

model ProfessionalProject {
  id                 String             @id @default(cuid())
  professionalId     String
  title              String
  description        String?            @db.Text
  projectLink        String?
  mediaUrl           String?
  /// Inclusive project span (month 1–12, four-digit year). All optional; partial pairs ignored on read.
  startMonth         Int?
  startYear          Int?
  endMonth           Int?
  endYear            Int?
  teamMembers        Json?
  /// e.g. self_declaration, work_email, portfolio — parity with work/education verification.
  verificationMethod String?
  verificationStatus VerificationStatus @default(pending)
  verifiedAt         DateTime?
  reviewedBy         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("professional_projects")
}

model Job {
  id                    String         @id @default(cuid())
  organisationId        String
  jobTitle              String
  department            String?
  location              String
  workMode              WorkMode
  employmentType        EmploymentType
  experienceYears       Int?
  jobLevel              String?
  pay                   Json
  startDate             DateTime?
  endDate               DateTime?
  closingDate           DateTime?
  description           String         @default("")
  requirements          String[]
  applyCTA              Json?
  qualifyingQuestions   Json?          // [{ question: string }]
  requiredApplicantData String[]        @default([]) // full_name, email, nationality, location, phone, government_id, academic_data, work_data, skill_set, social_media, financial_data, reference_data
  distributionChannels  String[]       @default([]) // taldium_network, google_search, monday_com, lensa, linkedin, indeed, glassdoor
  status                JobStatus      @default(draft)
  views                 Int            @default(0)
  postedBy              String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  applications JobApplication[]
  savedBy      SavedJob[]

  @@map("jobs")
}

model JobApplication {
  id              String   @id @default(cuid())
  jobId           String
  professionalId  String
  applicationData Json?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([jobId, professionalId])
  @@map("job_applications")
}

model SavedJob {
  id             String   @id @default(cuid())
  professionalId String
  jobId          String
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([professionalId, jobId])
  @@map("saved_jobs")
}

model ProfessionalJobSettings {
  id              String   @id @default(cuid())
  professionalId  String   @unique
  jobTitles       String[] @default([])
  workMode        String?
  location        String?
  employmentType  String?
  allowRecruiters Boolean  @default(true)
  automationFlows Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("professional_job_settings")
}
