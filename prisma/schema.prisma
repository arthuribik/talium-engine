// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  UNVERIFIED
  VERIFIED
  ACTIVE
  SUSPENDED
  PENDING_INVITATION
}

enum UserType {
  ADMIN
  ORGANISATION
  PROFESSIONAL
}

enum AdminRole {
  super_admin
  admin
  support
  auditor
}

enum OrgRole {
  org_owner
  org_admin
  org_recruiter
  org_member
}

enum VerificationStatus {
  pending
  under_review
  verified
  rejected
  not_activated
}

enum JobStatus {
  draft
  published
  paused
  closed
}

enum EmploymentType {
  full_time
  part_time
  contract
  internship
}

enum WorkMode {
  remote
  hybrid
  on_site
  global_remote
}

enum IDType {
  national_id
  passport
  drivers_license
  voters_card
}

enum EducationLevel {
  high_school
  associate
  bachelor
  master
  doctorate
  certificate
  diploma
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  password          String
  firstName         String
  lastName          String
  phoneNumber       String?
  status            UserStatus @default(UNVERIFIED)
  userType          UserType
  emailVerified     Boolean    @default(false)
  emailVerifyToken  String?
  emailVerifyExpiry DateTime?
  resetToken        String?
  resetTokenExpiry  DateTime?
  firstLogin        Boolean    @default(true)
  twoFactorEnabled  Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  adminProfile Admin?
  organisation Organisation?
  professional Professional?
  organisationMembers OrganisationMember[]

  @@map("users")
}

model Admin {
  id                  String    @id @default(cuid())
  userId              String    @unique
  role                AdminRole @default(admin)
  invitationToken     String?   @unique
  invitationExpiresAt DateTime?
  invitationSentAt    DateTime?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model Organisation {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  companyName            String
  country                String
  isRegistered           Boolean            @default(false)
  incorporationStatus    String?
  countryOfIncorporation String?
  incorporationNumber    String?
  yearOfCommencement     Int?
  industry               String?
  companySize            String?
  website                String?
  description            String?
  verificationStatus     VerificationStatus @default(not_activated)
  setupCompleted         Boolean            @default(false)
  profileCompleteness    Int                @default(0)
  address                Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationRequests OrganisationVerification[]
  jobs                 Job[]
  members              OrganisationMember[]
  invitations          OrganisationInvitation[]
  keyEmployees         OrganisationKeyEmployee[]

  @@map("organisations")
}

model OrganisationKeyEmployee {
  id             String   @id @default(cuid())
  organisationId String
  firstName      String
  lastName       String
  title          String
  bio            String?  @db.Text
  email          String?
  linkedInUrl    String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@map("organisation_key_employees")
}

model OrganisationMember {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  role           OrgRole  @default(org_member)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@map("organisation_members")
}

model OrganisationInvitation {
  id             String   @id @default(cuid())
  organisationId String
  email          String
  role           OrgRole
  token          String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, email])
  @@map("organisation_invitations")
}

model OrganisationVerification {
  id                      String             @id @default(cuid())
  organisationId          String
  status                  VerificationStatus @default(under_review)
  documents               Json
  submittedAt             DateTime           @default(now())
  estimatedCompletionDate DateTime?
  reviewedAt              DateTime?
  reviewedBy              String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@map("organisation_verifications")
}

model Professional {
  id                  String             @id @default(cuid())
  userId              String             @unique
  profession          String?
  gender              String?
  middleName          String?
  country             String?
  nationality         String?
  dateOfBirth         DateTime?
  description         String?
  socialMedia         Json?
  certifications      Json?
  familyInfo          Json?
  idType              IDType?
  idNumber            String?
  idDocumentUrl       String?
  locationDocumentType String?
  locationDocumentUrl  String?
  locations            Json?
  identityVerified    Boolean            @default(false)
  identityStatus      VerificationStatus @default(not_activated)
  verifiedByAdminAt   DateTime?
  setupCompleted      Boolean            @default(false)
  profileCompleteness Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityVerification IdentityVerification?
  education            Education[]
  workExperience       WorkExperience[]
  jobApplications      JobApplication[]
  savedJobs            SavedJob[]

  @@map("professionals")
}

model IdentityVerification {
  id                String             @id @default(cuid())
  professionalId    String             @unique
  nationality       String
  idType            IDType
  idNumber          String
  dateOfBirth       DateTime
  status            VerificationStatus @default(pending)
  livenessCheckData Json?
  verifiedAt        DateTime?
  reviewedBy        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("identity_verifications")
}

model Education {
  id                    String             @id @default(cuid())
  professionalId        String
  levelOfEducation      EducationLevel
  programLevel          String?
  institutionName       String
  degreeType            String?
  fieldOfStudy          String
  startDate             String
  endDate               String?
  currentlyAttending    Boolean            @default(false)
  grade                 String?
  costOfEducation       Float?
  currency              String?
  country               String
  verificationStatus    VerificationStatus @default(pending)
  verificationDocuments Json?
  verifiedAt            DateTime?
  reviewedBy            String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("educations")
}

model WorkExperience {
  id                  String             @id @default(cuid())
  professionalId      String
  organisationName    String
  industry            String
  location            Json
  role                String
  employmentType      EmploymentType
  workMode            WorkMode
  startDate           String
  endDate             String?
  currentlyWorking    Boolean            @default(false)
  responsibilities    String[]
  achievements        String[]
  paymentMode         String?
  currency            String?
  salaryRange         Json?
  verificationStatus  VerificationStatus @default(pending)
  verificationContact Json?
  verifiedAt          DateTime?
  reviewedBy          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("work_experiences")
}

model Job {
  id                    String         @id @default(cuid())
  organisationId        String
  jobTitle              String
  department            String?
  location              String
  workMode              WorkMode
  employmentType        EmploymentType
  experienceYears       Int?
  jobLevel              String?
  pay                   Json
  startDate             DateTime?
  endDate               DateTime?
  closingDate           DateTime?
  description           String         @default("")
  requirements          String[]
  applyCTA              Json?
  qualifyingQuestions   Json?          // [{ question: string }]
  requiredApplicantData String[]        @default([]) // full_name, email, nationality, location, phone, government_id, academic_data, work_data, skill_set, social_media, financial_data, reference_data
  distributionChannels  String[]       @default([]) // taldium_network, google_search, monday_com, lensa, linkedin, indeed, glassdoor
  status                JobStatus      @default(draft)
  views                 Int            @default(0)
  postedBy              String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  applications JobApplication[]
  savedBy      SavedJob[]

  @@map("jobs")
}

model JobApplication {
  id              String   @id @default(cuid())
  jobId           String
  professionalId  String
  applicationData Json?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([jobId, professionalId])
  @@map("job_applications")
}

model SavedJob {
  id             String   @id @default(cuid())
  professionalId String
  jobId          String
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([professionalId, jobId])
  @@map("saved_jobs")
}
